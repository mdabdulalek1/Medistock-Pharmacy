rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'avatar']);
      allow delete: if false;
    }

    // Branches Collection (Publicly visible branch directory)
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Medicines Catalogue (Publicly visible drug registry)
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Batch Inventory
    match /batches/{batchId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Sales Tax Invoices
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Invoices are immutable
    }

    // Online Delivery Orders
    match /onlineOrders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Stock Movement Ledger: strictly Append-Only, no updates or deletes
    match /stockMovements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // IMMUTABLE APPEND-ONLY
    }
  }
}
